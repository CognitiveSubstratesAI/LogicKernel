#!/usr/bin/env bash
# tools/githooks/pre-push — six refusals.
#
# 1. A MUTANT WORKTREE never pushes (user, 2026-10-11). tools/mutate.sh builds a second worktree of
#    this repository in which mutants are applied — deliberately broken code, on a detached HEAD —
#    and marks it with .warm/MUTANT_WORKTREE. Nothing made there may reach the history.
#
# 2. `main` TAKES ONLY A COMMIT THE EVIDENCE WORKFLOW JUDGED GREEN (user, 2026-10-13). The gate:
#    commit → push to a branch `gate/<name>` → .github/workflows/evidence.yml runs the whole suite
#    there, three term types in parallel → `main` is fast-forwarded to THAT commit. So a push that
#    updates `refs/heads/main` is refused unless tools/ci_status.sh reports, for exactly the pushed
#    commit, every workflow run completed and green AND a run of the evidence workflow among them.
#    A run that is MISSING, RED or STILL RUNNING is a refusal — "no run found" is not green — and so
#    is an unreadable answer (no network, an API error): the hook fails closed.
#    Not in the commit: the run cannot be named in a trailer, because it exists only after the
#    commit does, and amending would make `main` a commit CI never saw.
#    Any other branch, and tags, are not this hook's: a gate branch is pushed BEFORE its run exists.
#
#    THE FALLBACK, when CI itself is down (user: "local full evidence runs only as a fallback"):
#    LOGICKERNEL_PUSH_LOCAL_EVIDENCE=<the full SHA being pushed> — it must name that commit, the
#    checkout must be that commit with nothing changed, and the workspace's evidence marker must
#    say a FULL local suite on every term type passed on this tree (tools/run_tests.sh writes it).
#    In a clone without that marker's helper the fallback cannot be checked, and is refused.
#
# 3. EVERY NEW COMMIT CARRIES THE NOREPLY IDENTITY (user, 2026-10-14). LogicKernel's public
#    history carried the personal address from its first commit; it is not rewritten (its SHAs are
#    cited everywhere), but from now on a push of ANY ref is refused if a commit GitHub does not
#    have yet — `git log <sha> --not --remotes=<remote>` — has an author or committer email other
#    than $NOREPLY_EMAIL. Commits already on the remote (any branch) pass, so main can move
#    over commits a gate branch already carried. An unreadable range is a refusal.
#    The remote is the one git names; a push by URL is read as the configured remote with that URL
#    (below, 2026-10-23).
#
# 4. A wip/ BRANCH NEVER PUSHES (user, 2026-10-16). The workspace's commit hook lets a commit on a
#    `wip/*` branch through WITHOUT test evidence (a step's work in progress, kept as commits so a fix
#    rebases with git's three-way merge instead of text-matched patch scripts) — on the condition that
#    THIS hook refuses to push it. So any pushed ref whose local or remote side is `refs/heads/wip/*`
#    is refused: an unevidenced commit leaves the machine only after it is re-made on a gate branch.
#
# 5. A mutants/<name> BRANCH TAKES ONLY A COMMIT THAT HAS tools/mutants/<name>.py (user, 2026-10-24).
#    .github/workflows/mutation.yml takes its mutant list from the branch name (`tools/{ref_name}.py`).
#    A push to mutants/Sync2b whose commit had no tools/mutants/Sync2b.py failed the workflow's Plan
#    job, ran no mutant, and left a red run that blocked main's push (tools/ci_status.sh counts every
#    run of a sha) until it was deleted by hand. So a push whose remote ref is `refs/heads/mutants/<name>`
#    is refused unless the pushed commit holds that file. A delete (all-zero local sha) is allowed.
#    The file must also define `TARGETS` (2026-10-25): the Plan job hands the list's TARGETS to the
#    Baseline job of a push-started run, and two lists without it (FindallAlloc, NF2) gave a baseline
#    with no target — red in 0 s, so no mutant's verdict counted.
#
# 6. A gate/<name> PUSH RUNS THE COVERAGE-ZERO PRE-CHECK (audit D-0178 item 2, 2026-10-26). CI's ratchet
#    (tools/coverage_zero.py on the groups' lcov) failed gate/f1a with every test green: a step had
#    first covered src/os/pl-prologflag.jl and left it on tools/coverage_zero_known.txt. Real coverage
#    needs the whole suite, so tools/check_coverage_zero.sh runs a STATIC PROXY on the src/ files the push
#    changes (against refs/remotes/<remote>/main) — its header says what it checks and what it cannot;
#    with LOGICKERNEL_COVZERO_LCOV=<lcov> it gives CI's exact verdict for those files instead. A
#    listed file the push changes is refused unless LOGICKERNEL_COVZERO_ACK="src/x.jl ..." names it
#    (still 0% on purpose). No verdict (an unreadable ref/list) is a refusal. Tests: tools/test_check_coverage_zero.sh.
#
# LOGICKERNEL_CI_FIXTURE (tools/ci_status.sh) lets test/test_gate_split.jl plant each answer.
NOREPLY_EMAIL="11524260+sivaji1012@users.noreply.github.com"
EVIDENCE_WORKFLOW="Evidence (three term types)"     # 🔴 evidence.yml's `name:` — rename both or neither
top="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
if [ -e "$top/.warm/MUTANT_WORKTREE" ]; then
    echo "pre-push: REFUSED — $top is the mutant worktree of $(cat "$top/.warm/MUTANT_WORKTREE"): it holds mutated code and never pushes. Work in the main tree; remove this one with tools/mutate.sh remove." >&2
    exit 1
fi

# _local_evidence SHA — 0 when the declared fallback holds for SHA (see the header)
_local_evidence() {
    local sha="$1" lib=""
    [ "${LOGICKERNEL_PUSH_LOCAL_EVIDENCE:-}" = "$sha" ] || {
        echo "pre-push: LOGICKERNEL_PUSH_LOCAL_EVIDENCE=${LOGICKERNEL_PUSH_LOCAL_EVIDENCE:-} does not name the pushed commit $sha" >&2
        return 1
    }
    [ "$(git -C "$top" rev-parse HEAD)" = "$sha" ] && [ -z "$(git -C "$top" status --porcelain)" ] || {
        echo "pre-push: the local-evidence fallback needs this checkout to BE $sha, with nothing changed" >&2
        return 1
    }
    for lib in "$top/../workflows/test_marker.sh" \
        "${LOGICKERNEL_WORKSPACE:-$HOME/code/CognitiveSubstratesAI}/workflows/test_marker.sh"; do
        [ -f "$lib" ] && break
        lib=""
    done
    [ -n "$lib" ] || {
        echo "pre-push: the local-evidence fallback cannot be checked here (no workflows/test_marker.sh)" >&2
        return 1
    }
    # shellcheck source=/dev/null
    . "$lib"
    check_marker "$top" || {
        echo "pre-push: no local evidence for this tree (the marker is missing, or for other content)" >&2
        return 1
    }
    sed -n 3p "$(marker_path "$top")" | grep -q '^run_tests.sh full suite (term types: all' || {
        echo "pre-push: the local evidence is not a full suite on every term type: $(sed -n 3p "$(marker_path "$top")")" >&2
        return 1
    }
    echo "pre-push: main ← ${sha:0:7} on LOCAL evidence (the declared fallback; no green CI evidence run)" >&2
    return 0
}

# _identity_check SHA — 0 when every commit of SHA not yet on the remote is noreply (see 3.)
_identity_check() {
    local sha="$1" out bad
    out="$(git -C "$top" log --format='%h %ae %ce' "$sha" --not --remotes="${remote_name:-origin}" 2>&1)" || {
        echo "pre-push: REFUSED — cannot list the commits of ${sha:0:7} not yet on the remote: $out" >&2
        return 1
    }
    bad="$(printf '%s\n' "$out" | awk -v e="$NOREPLY_EMAIL" 'NF && ($2 != e || $3 != e)')"
    [ -z "$bad" ] && return 0
    echo "pre-push: REFUSED — commit(s) not yet on GitHub carry an address other than $NOREPLY_EMAIL (sha author committer):" >&2
    printf '%s\n' "$bad" | sed 's/^/  /' >&2
    echo "  Re-author them with the repo-local identity: git rebase <base> --exec 'git commit --amend --no-edit --reset-author'" >&2
    return 1
}

remote_name="${1:-origin}"
# A push by URL (`git push https://…`) hands the URL as $1, and `--remotes=<URL>` matches no ref: every
# commit would count as new (measured 2026-10-23, the v0.1.0-pre.2 tag push: 140 old commits listed).
# So a $1 that names no configured remote but equals one's fetch or push URL — credentials stripped on
# both sides — is read as that remote's name; anything else stays as given (fail closed, as before).
_strip_cred() { printf '%s' "$1" | sed -E 's|://[^@/]*@|://|'; }
if ! git -C "$top" remote | grep -qxF -- "$remote_name"; then
    want="$(_strip_cred "$remote_name")"
    for r in $(git -C "$top" remote); do
        if [ "$(_strip_cred "$(git -C "$top" remote get-url "$r")")" = "$want" ] ||
            [ "$(_strip_cred "$(git -C "$top" remote get-url --push "$r")")" = "$want" ]; then
            remote_name="$r"
            break
        fi
    done
fi
rc=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
    case "$_local_ref $remote_ref" in
        refs/heads/wip/* | *" refs/heads/wip/"*)                # 4. a wip/ branch never pushes
            echo "pre-push: REFUSED — $_local_ref → $remote_ref: a wip/ branch holds commits made without test evidence (the commit hook's wip/ exemption); it never leaves this machine — re-make the step on a gate branch" >&2
            rc=1
            continue
            ;;
    esac
    case "$remote_ref" in
        refs/heads/mutants/*)                                   # 5. its list file must be in the commit
            case "$local_sha" in
                *[!0]*)
                    _mname="${remote_ref#refs/heads/mutants/}"
                    git -C "$top" cat-file -e "$local_sha:tools/mutants/$_mname.py" 2>/dev/null || {
                        echo "pre-push: REFUSED — $remote_ref ← ${local_sha:0:7}: the commit has no tools/mutants/$_mname.py, and mutation.yml takes its mutant list from the branch name — the Plan job would fail and leave a red run that blocks main. Name the branch after the list file, or add the file." >&2
                        rc=1
                        continue
                    }
                    git -C "$top" show "$local_sha:tools/mutants/$_mname.py" | grep -qE '^TARGETS[[:space:]]*=' || {
                        echo "pre-push: REFUSED — $remote_ref ← ${local_sha:0:7}: tools/mutants/$_mname.py defines no TARGETS, and mutation.yml's Baseline job of a push-started run takes its targets from it — it would run no target and no verdict would count. Add TARGETS = [the test files]." >&2
                        rc=1
                        continue
                    }
                    ;;
            esac
            ;;
    esac
    case "$local_sha" in
        *[!0]*) _identity_check "$local_sha" || { rc=1; continue; } ;;
    esac
    case "$remote_ref" in
        refs/heads/gate/*)                                      # 6. the coverage-zero pre-check
            case "$local_sha" in
                *[!0]*)
                    [ -x "$top/tools/check_coverage_zero.sh" ] || {
                        echo "pre-push: REFUSED — $remote_ref ← ${local_sha:0:7}: tools/check_coverage_zero.sh is missing or not executable here, so the coverage-zero pre-check cannot run" >&2
                        rc=1
                        continue
                    }
                    (cd "$top" && ./tools/check_coverage_zero.sh ${LOGICKERNEL_COVZERO_LCOV:+--lcov "$LOGICKERNEL_COVZERO_LCOV"} "refs/remotes/$remote_name/main" "$local_sha") >&2 || {
                        echo "pre-push: REFUSED — $remote_ref ← ${local_sha:0:7}: the coverage-zero pre-check (6.) found what CI's ratchet would, or could not judge" >&2
                        rc=1
                        continue
                    }
                    ;;
            esac
            ;;
    esac
    [ "$remote_ref" = "refs/heads/main" ] || continue
    case "$local_sha" in
        *[!0]*) ;;
        *)                                              # all zeros: deleting the branch
            echo "pre-push: REFUSED — deleting main" >&2
            rc=1
            continue
            ;;
    esac
    out="$("$top/tools/ci_status.sh" --require "$EVIDENCE_WORKFLOW" "$local_sha" 2>&1)"
    st=$?
    if [ "$st" -eq 0 ]; then
        echo "pre-push: main ← ${local_sha:0:7}: green, the evidence workflow among its runs" >&2
        printf '%s\n' "$out" | sed 's/^/  /' >&2
        continue
    fi
    if [ -n "${LOGICKERNEL_PUSH_LOCAL_EVIDENCE:-}" ] && _local_evidence "$local_sha"; then
        continue
    fi
    case "$st" in
        1) why="a workflow run of it is RED" ;;
        3) why="no verdict: a run is missing or still going — \`$EVIDENCE_WORKFLOW\` must have run on this commit and finished green" ;;
        *) why="the CI answer is unreadable (exit $st): failing closed" ;;
    esac
    echo "pre-push: REFUSED — main ← ${local_sha:0:7}: $why" >&2
    printf '%s\n' "$out" | sed 's/^/  /' >&2
    echo "  The gate: push the commit to a branch gate/<name>, wait for its evidence run, then fast-forward main to it." >&2
    rc=1
done
exit "$rc"
