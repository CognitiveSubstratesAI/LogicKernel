+# _ci_terms_check SHA — 0 when no added line of main..SHA and no commit message of that range holds a D-0164 term (see 7.)
+_ci_terms_check() {
+    local sha="$1" d m dh mh
+    d="$(git -C "$top" diff "refs/remotes/$remote_name/main..$sha" 2>&1)" || {
+        echo "pre-push: REFUSED — cannot diff refs/remotes/$remote_name/main..${sha:0:7} for the D-0164 term grep: $d" >&2
+        return 1
+    }
+    m="$(git -C "$top" log "refs/remotes/$remote_name/main..$sha" --format='%H %B' 2>&1)" || {
+        echo "pre-push: REFUSED — cannot list refs/remotes/$remote_name/main..${sha:0:7} for the D-0164 term grep: $m" >&2
+        return 1
+    }
+    dh="$(printf '%s\n' "$d" | grep -E '^\+[^+]' | grep -iE "$TERMS164")"
+    mh="$(printf '%s\n' "$m" | grep -iE "$TERMS164")"
+    [ -z "$dh" ] && [ -z "$mh" ] && return 0
+    echo "pre-push: REFUSED — D-0164: ${sha:0:7} adds a term that names an upstream failure in public text (added line or commit message); reword:" >&2
+    printf '%s\n%s\n' "$dh" "$mh" | grep . | cut -c1-200 | sed 's/^/  /' >&2
+    return 1
